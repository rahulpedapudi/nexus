# ── Infrastructure ────────────────────────────────────────────
ENVIRONMENT=LOCAL
PORT=8000
POSTGRES_PASSWORD=change_me
DATABASE_URL=
# ── Security ──────────────────────────────────────────────────
JWT_SECRET=
FERNET_KEY=

# ── LLM ───────────────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-oss-120b

# ── Embeddings ────────────────────────────────────────────────
GOOGLE_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2

# ── Bots (leave blank to disable) ────────────────────────────
TELEGRAM_TOKEN=
DISCORD_TOKEN=